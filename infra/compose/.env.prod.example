# ═══════════════════════════════════════════════════════════════════════════
# QuickDrop — بيئة الإنتاج. انسخه:  cp .env.prod.example .env.prod  ثم املأ القيم.
# .env.prod أسرارٌ حية — ممنوع رفعه للريبو (§11)، أذونات ملف 600، تدوير عبر runbook.
# يقرؤه docker-compose.prod.yml مرتين: (أ) --env-file للاستبدال ${..}، (ب) env_file لكل تطبيق.
# ⚠ السطور المعلّمة [سر] = ولّدها عشوائياً ولا تكتبها بأي مكان آخر.
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3000

# —— النطاقات وTLS (Caddy §1) ——
API_DOMAIN=api.quickdrop.example
DASHBOARD_DOMAIN=app.quickdrop.example
# بريد ACME لإشعارات انتهاء الشهادة (Let's Encrypt)
ACME_EMAIL=ops@quickdrop.example

# —— صور الحاويات (GitHub Actions → GHCR → السيرفر §12) ——
# REGISTRY بلا شرطة نهائية؛ الصور: ${REGISTRY}/api|worker|dashboard|migrate:${IMAGE_TAG}
REGISTRY=ghcr.io/your-org/quickdrop
# ثبّته على وسم/‏SHA محدد لكل نشرة — لا تعتمد latest بالإنتاج
IMAGE_TAG=latest

# ─── قاعدة البيانات (§2.3) ───────────────────────────────────────────────────
# [سر] كلمة سر superuser (postgres) — للتهيئة والصيانة فقط، ليست مسار تطبيق
POSTGRES_PASSWORD=CHANGE_ME_postgres_superuser
# [سر] كلمات سر الأدوار — تنشئها initdb-prod/01-roles.sh. ولّد كلاً بـ: openssl rand -hex 32
# ⚠ يجب أن تطابق حرفياً الكلمات المُضمّنة بـ DATABASE_URL* أدناه (نفس القيمة بمكانين).
DB_MIGRATOR_PASSWORD=CHANGE_ME_migrator
DB_APP_PASSWORD=CHANGE_ME_app_user
DB_WORKER_PASSWORD=CHANGE_ME_app_worker
DB_BACKUP_PASSWORD=CHANGE_ME_backup

# أسماء المضيفين داخلية (شبكة docker) — المنفذ 5432 غير مكشوف للمضيف (§11)
# [سر] تحوي كلمات السر أعلاه — حدّثها معاً
DATABASE_URL=postgres://app_user:CHANGE_ME_app_user@postgres:5432/quickdrop
DATABASE_URL_MIGRATOR=postgres://migrator:CHANGE_ME_migrator@postgres:5432/quickdrop
DATABASE_URL_WORKER=postgres://app_worker:CHANGE_ME_app_worker@postgres:5432/quickdrop

# —— Redis (داخلي فقط §11) ——
REDIS_URL=redis://redis:6379

# ─── الأسرار التطبيقية ───────────────────────────────────────────────────────
# [سر] MASTER_KEY: 32 بايت hex لتشفير توكنات البوتات (§4.2) — openssl rand -hex 32
MASTER_KEY=CHANGE_ME_openssl_rand_hex_32
# [سر] STAFF_API_TOKEN: مسارات /api/* — ≥ 32 محرفاً. نفس القيمة للـ API والداشبورد.
#      غيابه = /api/* ترد 503 (معطّلة بصوت عالٍ). openssl rand -hex 32
STAFF_API_TOKEN=CHANGE_ME_openssl_rand_hex_32
# [سر] ADMIN_API_TOKEN: مسارات /api/admin/* — منفصل تماماً عن STAFF (§10.2). openssl rand -hex 32
ADMIN_API_TOKEN=CHANGE_ME_openssl_rand_hex_32
# (اختياري) هوية المشرف الفاعل التي توقّع audit_log (§10.2) — uuid لصف admin_users
# ADMIN_ID=00000000-0000-0000-0000-000000000000

# —— webhook تيليغرام (§4.4) — يستعمله provision-tenant لتسجيل PUBLIC_URL/tg/<slug> ——
PUBLIC_URL=https://api.quickdrop.example

# ─── الداشبورد (apps/dashboard) ──────────────────────────────────────────────
# عنوان الـ API للـ proxy الخادمي (داخلي، لا يصل المتصفح)
API_URL=http://api:3000
# مستأجر الداشبورد الوحيد (slug من provision-tenant)
TENANT_SLUG=demo
# ⚠ NEXT_PUBLIC_* تُخبز نصياً بحزمة المتصفح وقت `next build` — لا وقت التشغيل.
#   مرّرها كـ build-args بالـ CI عند بناء صورة الداشبورد؛ القيم هنا للمرجع/البناء المحلي.
#   قيم عامة فقط — لا سر هنا أبداً (§11). بلا شرطة نهائية.
NEXT_PUBLIC_API_URL=https://api.quickdrop.example
NEXT_PUBLIC_TENANT_SLUG=demo

# ─── MinIO / تخزين S3 لإثبات التسليم POD (§11) ───────────────────────────────
# [سر] بيانات جذر MinIO — MINIO_ROOT_USER ≥ 3 محارف، MINIO_ROOT_PASSWORD ≥ 8 (استعمل openssl rand -hex 32)
MINIO_ROOT_USER=quickdrop
MINIO_ROOT_PASSWORD=CHANGE_ME_openssl_rand_hex_32
# اسم دلو POD (تنشئه خدمة minio-setup، خاص — روابط موقّعة فقط)
POD_BUCKET=quickdrop-pod
# متغيرات وصول الـ API لـ S3 (تُستعمل حين يُوصَّل رفع POD §11). endpoint داخلي:
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_BUCKET=quickdrop-pod
# [سر] أنشئ مفتاح وصول مخصّصاً بـ mc admin بدل جذر MinIO بالإنتاج:
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME
