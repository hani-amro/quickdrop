{
  "name": "@quickdrop/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "provision-tenant": "tsx src/cli/provision-tenant.ts",
    "create-staff": "tsx src/cli/create-staff.ts",
    "create-admin": "tsx src/cli/create-admin.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@node-rs/argon2": "^2.0.2",
    "@quickdrop/db": "workspace:*",
    "@quickdrop/shared": "workspace:*",
    "@quickdrop/spine": "workspace:*",
    "@quickdrop/storage": "workspace:*",
    "@quickdrop/telegram": "workspace:*",
    "@quickdrop/whatsapp": "workspace:*",
    "@sentry/node": "^10.65.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.3",
    "zod": "^3.24.0",
    "@quickdrop/billplz": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}