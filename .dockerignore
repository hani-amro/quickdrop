# =============================================================================
# سياق بناء الصور (§12) — يُستبعد كل ما يُعاد توليده داخل الصورة أو يجب ألّا يدخلها.
# مخرجات المضيف (ويندوز) تُستبعد قصداً كي يُعاد البناء نظيفاً على منصّة لينكس.
# =============================================================================

# تبعيات ومخرجات بناء محلية — تُعاد بـ pnpm install + turbo build داخل الصورة
**/node_modules
**/dist
**/.next
**/.turbo
**/coverage
**/*.tsbuildinfo

# أسرار — never baked into images (§11): تُمرَّر عبر env وقت التشغيل حصراً
.env
.env.*
!.env.example

# نظام الإصدارات وCI (ليست وقت التشغيل)
.git
.gitignore
.gitattributes
.github

# اختبارات ولقطاتها — لا يحتاجها البناء (tsconfig يستبعدها أصلاً)
**/*.test.ts
**/*.spec.ts
**/vitest.config.*

# ملفات دوكر نفسها — لا داعي لإدراجها في السياق
**/Dockerfile
**/.dockerignore
infra/compose/docker-compose*.yml

# وثائق وسكراتش وترانسكربتات وسجلّات
**/*.md
scratchpad/
**/transcripts/
*.log
.DS_Store
.vscode/
.idea/
