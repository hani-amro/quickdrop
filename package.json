{
  "name": "quickdrop",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:up": "docker compose -f infra/compose/docker-compose.dev.yml up -d",
    "dev:down": "docker compose -f infra/compose/docker-compose.dev.yml down",
    "prod:up": "docker compose --env-file infra/compose/.env.prod -f infra/compose/docker-compose.prod.yml up -d",
    "prod:down": "docker compose --env-file infra/compose/.env.prod -f infra/compose/docker-compose.prod.yml down",
    "dev:api": "pnpm --filter @quickdrop/api dev",
    "dev:worker": "pnpm --filter @quickdrop/worker dev",
    "dev:dashboard": "pnpm --filter @quickdrop/dashboard dev",
    "dev:bot-poll": "pnpm --filter @quickdrop/worker bot-poll",
    "db:generate": "pnpm --filter @quickdrop/db generate",
    "db:migrate": "pnpm --filter @quickdrop/db migrate",
    "db:check-rls": "pnpm --filter @quickdrop/db check-rls",
    "db:check-money": "pnpm --filter @quickdrop/db check-money",
    "check:money-code": "node scripts/check-money-code.mjs",
    "db:seed-dev": "pnpm --filter @quickdrop/db seed-dev",
    "tenant:provision": "pnpm --filter @quickdrop/api provision-tenant --",
    "staff:create": "pnpm --filter @quickdrop/api create-staff --",
    "backup": "bash infra/scripts/backup.sh",
    "backup:restore-test": "bash infra/scripts/restore-test.sh"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
